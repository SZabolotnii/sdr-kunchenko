# Copy to .env and adjust paths to match your machine.
# .env is gitignored; this file is the canonical reference.

# Root directory containing the SDR dataset folders produced by
# `signal-denoising/data_generation/`. data_loader.get_data_root() raises
# EnvironmentError when this is unset — there is no silent fallback.
#
# Expected layout under this root:
#   <KU_SDR_DATA_ROOT>/
#     fpv_telemetry_polygauss_qpsk_*_n100000/
#     deep_space_polygauss_qpsk_*_n400000/
#     fpv_realnoise_bpsk_qpsk/
#     deep_space_realnoise_bpsk_qpsk/
#     radioml2018_bpsk_qpsk_fpv/
#     radioml2018_bpsk_qpsk_deep_space/
#
# See docs/specs/kunchenko_sdr_experiments.md "Real datasets" for the schema.
KU_SDR_DATA_ROOT=/path/to/signal-denoising/data_generation/datasets
